from __future__ import annotations

import argparse
import collections
import os
import pty
import subprocess
import sys
import threading
import time
import typing as t

from nineseconds import cli
from nineseconds import ntfy
from nineseconds import times


if t.TYPE_CHECKING:
    import datetime


class ProgressTracker:
    _counter: int
    _buffer: collections.deque[int]
    _lock: threading.Lock
    _th: threading.Thread
    _stop: threading.Event
    _have_updates: bool

    def __init__(
        self,
        updater: ntfy.Updater,
        show_bytes: int,
        update_each: datetime.timedelta,
    ) -> None:
        self._updater = updater
        self._buffer = collections.deque(maxlen=show_bytes)
        self._counter = 0
        self._have_updates = False
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._th = threading.Thread(target=self._track, args=(update_each,))

        self._th.start()

    def write(self, buf: bytes) -> None:
        with self._lock:
            self._have_updates = True
            self._counter += len(buf)
            self._buffer.extend(buf)

    def stop(self) -> None:
        if not self._stop.is_set():
            self._stop.set()
            self._th.join()

    def _track(self, update_each: datetime.timedelta) -> None:
        while not self._stop.wait(update_each.total_seconds()):
            with self._lock:
                if not self._have_updates:
                    continue
                data = bytes(self._buffer)
                self._have_updates = False

            message = f"Read {self._counter} bytes from stdout"

            try:
                text = data.decode("utf-8")
                message += f"\n\nLast {len(data)} bytes:\n\n{text}"
            except UnicodeDecodeError:
                pass

            self._updater.send(message)


@cli.main
def main() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Wait for commands with ntfy",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.set_defaults(cmd=run)
    ntfy.add_parser_options(parser)

    parser.add_argument(
        "-p",
        "--update-each",
        type=cli.type_duration,
        default="1m",
        help="notification period for a ntfy",
    )
    parser.add_argument(
        "-s",
        "--show-stdout-bytes",
        type=cli.type_non_negative_int,
        default=2048,
        help="Buffer size to show",
    )
    parser.add_argument(
        "-t",
        "--tty",
        action="store_true",
        default=False,
        help="require TTY for the command. won't attach any files",
    )
    parser.add_argument(
        "command", nargs=argparse.REMAINDER, help="command to execute"
    )

    return parser


def run(options: argparse.Namespace) -> None:
    if not options.command:
        return

    notifier = ntfy.Updater(
        ntfy.Ntfy.from_options(options),
        subprocess.list2cmdline(options.command),
        tags=["command"],
    )

    method = run_with_subprocess
    if options.tty:
        method = run_with_tty

    notifier.send("Start the process")
    tracker = ProgressTracker(
        notifier, options.show_stdout_bytes, options.update_each
    )

    start = time.monotonic()
    try:
        exit_code = method(tracker, options.command)
    finally:
        stop = time.monotonic()
        tracker.stop()

    elapsed = times.elapsed(stop - start)
    notifier.send(
        f"Process exited with {exit_code}. Elapsed {elapsed}.",
        tags=["x" if exit_code else "white_check_mark"],
    )

    sys.exit(exit_code)


def run_with_subprocess(tracker: ProgressTracker, command: list[str]) -> int:
    proc = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        stdin=sys.stdin,
        text=False,
    )

    with proc:
        for data in proc.stdout or []:
            tracker.write(data)
            os.write(sys.stdout.fileno(), data)

    return proc.returncode


def run_with_tty(tracker: ProgressTracker, command: list[str]) -> int:
    def master_read(fd: int) -> bytes:
        data = os.read(fd, 4096)
        tracker.write(data)
        return data

    return os.waitstatus_to_exitcode(pty.spawn(command, master_read))


if __name__ == "__main__":
    main()
