#!/usr/bin/env fish
# vim: set ts=2 sts=2 sw=2:

set this_script_path $(path resolve $(status --current-filename))
set this_script_name $(path basename $this_script_path)

function show_help
  echo "Usage: $this_script_name [-h/--help] [-d/--debug] [-t/--topic ...]"
  echo
  echo 'NTFY wrapper'
  echo
  echo "  -t / --topic   topic to use. Default is $(ntf-topic)"
  echo '  -h / --help    show this help'
  echo '  -d / --debug   run in debug mode'
end

argparse 'h/help&' 'd/debug&' 't/topic=&' -- $argv
or begin
  show_help
  return 1
end

if set -q _flag_debug
  set fish_trace 1
end
if set -q _flag_help
  show_help
  return 0
end

if set -q _flag_topic
  set topic $_flag_topic
else
  set topic (ntf-topic)
end

if not set -q NTFY_SERVER
  set NTFY_SERVER https://ntfy.sh
end

if not set -q NTFY_TOPIC
  set -gx NTFY_TOPIC {$NTFY_SERVER}/{$topic}
end

exec ntfy $argv
