from __future__ import annotations

import argparse
import json
import logging
import sys
import time
import typing as t

from nineseconds import cli
from nineseconds import net
from nineseconds import ntfy
from nineseconds import times


LOG: t.Final = logging.getLogger(__name__)


@cli.main
def main() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Wait for Jenkins job to finish with ntfy",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.set_defaults(cmd=run)
    ntfy.add_parser_options(parser)

    parser.add_argument(
        "-p",
        "--update-each",
        type=cli.type_duration,
        default="1m",
        help="notification period for a ntfy",
    )
    parser.add_argument("url", type=net.URL, help="url of the job")

    return parser


def run(options: argparse.Namespace) -> None:
    url = t.cast("net.URL", options.url)

    parameters_url = url.copy()
    parameters_url.path /= "parameters"

    actions = [
        {"action": "view", "label": "Open", "url": url.url()},
        {"action": "view", "label": "Parameters", "url": parameters_url.url()},
    ]

    notifier: ntfy.Updater | None = None

    while True:
        data = make_request(url)

        if notifier is None:
            notifier = ntfy.Updater(
                ntfy.Ntfy.from_options(options),
                data["fullDisplayName"],
                tags=["jenkins"],
            )

        start = float(data["timestamp"]) / 1_000.0
        now = time.time()
        elapsed = now - start

        duration = float(data["estimatedDuration"]) / 1_000.0
        percents = round(100.0 * elapsed / duration, 2)
        if percents >= 100.0:  # noqa: PLR2004
            percents = 99.99

        LOG.debug("Got %s, percents %f", data, percents)

        match data:
            case {"building": True}:
                message = f"Ready on {percents}%."
                if elapsed < duration:
                    message = f"{message} Elapsed {times.elapsed(elapsed)}."
                notifier.send(message, priority=1, actions=actions)

            case {"result": "SUCCESS" | "UNSTABLE"}:
                notifier.send(
                    "Done", tags=["white_check_mark"], actions=actions
                )
                sys.exit(0)

            case {"result": "FAILURE"}:
                build_artifacts_url = url.copy()
                build_artifacts_url.path = build_artifacts_url.path.joinpath(
                    "artifact", "bld"
                )

                notifier.send(
                    "Failed",
                    tags=["x"],
                    actions=[
                        *actions,
                        {
                            "action": "view",
                            "label": "Build artifacts",
                            "url": build_artifacts_url.url(),
                        },
                    ],
                )
                sys.exit(1)
            case {"result": "ABORTED"}:
                LOG.info("Aborted")
                sys.exit(1)

        time.sleep(options.update_each.total_seconds())


def make_request(base_url: net.URL) -> dict[str, t.Any]:
    api_url = base_url.copy()
    api_url.query["tree"] = [
        ",".join(  # noqa: FLY002
            [
                "estimatedDuration",
                "timestamp",
                "fullDisplayName",
                "building",
                "result",
            ]
        )
    ]
    if api_url.path.parts[-2:] != ("api", "json"):
        api_url.path = api_url.path.joinpath("api", "json")

    req = net.Request(api_url)
    req = req.header("accept", "application/json")
    req = req.header("content-type", "application/json")

    resp, _ = req.do()
    return t.cast("dict[str, t.Any]", json.loads(resp))


if __name__ == "__main__":
    main()
