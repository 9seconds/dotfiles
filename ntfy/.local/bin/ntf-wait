#!/usr/bin/env fish
# vim: set ts=2 sts=2 sw=2:

set this_script_path $(path resolve $(status --current-filename))
set this_script_name $(path basename $this_script_path)

function show_help
  echo "Usage: $this_script_name [-h/--help] [-d/--debug]"
  echo
  echo 'Wait for the command to stop and ntfy after'
  echo
  echo '  -h / --help    show this help'
  echo '  -d / --debug   run in debug mode'
end

argparse 'h/help&' 'd/debug&' -- $argv
or begin
  show_help
  return 1
end

if set -q _flag_debug
  set fish_trace 1
end
if set -q _flag_help
  show_help
  return 0
end

set -a fzf_flags --nth 3..
set -a fzf_flags --no-sort
set -a fzf_flags --accept-nth 1
set -a fzf_flags --exact

if test (count $argv) -ne 0
  set -a fzf_flags --select-1
  set -a fzf_flags "--query=$(string join -- ' ' $argv)"
end

set pid (ps -efx --no-headers -o pid,cmd | 9fzf $fzf_flags)
if test $status -eq 130
  return 130
end

set pid (string trim -- $pid)
if test -n "$pid"
  exec ntf -- publish --wait-pid $pid
end
