from __future__ import annotations

import argparse
import logging
import random
import subprocess
import sys
import time
import typing as t

from nineseconds import cli
from nineseconds import cmd
from nineseconds import env


LOG: t.Final = logging.getLogger(__name__)
ENV_PREFIX: t.Final = f"{env.PREFIX}_RETRY"


@cli.main
def main() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="9seconds retries commands.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.set_defaults(cmd=run)

    parser.add_argument(
        "-n",
        "--number",
        type=cli.type_non_negative_int,
        **cli.env_argument(
            "how many times should we retry",
            f"{ENV_PREFIX}_NUMBER",
            lambda: "3",
        ),
    )
    parser.add_argument(
        "-b",
        "--base",
        type=cli.type_duration,
        **cli.env_argument(
            "base value of a sleep between retries",
            f"{ENV_PREFIX}_BASE",
            lambda: "3s",
        ),
    )
    parser.add_argument(
        "-c",
        "--cap",
        type=cli.type_duration,
        **cli.env_argument(
            "max sleep time on retry",
            f"{ENV_PREFIX}_CAP",
            lambda: "1m",
        ),
    )
    parser.add_argument(
        "-i",
        "--inverse",
        **cli.env_bool_argument(
            "inverse ok logic",
            f"{ENV_PREFIX}_INVERSE",
            lambda: False,
        ),
    )

    parser.add_argument(
        "command",
        nargs=argparse.ONE_OR_MORE,
        help="command to execute",
    )

    return parser


def run(options: argparse.Namespace) -> None:
    str_cmd = subprocess.list2cmdline(options.command)
    cap = options.cap.total_seconds()
    base = options.base.total_seconds()
    sleep_time = min(cap, base)

    for attempt in range(options.number):
        LOG.debug("Attempt %d. Execute %s", attempt + 1, str_cmd)

        with cmd.run_in_foreground(*options.command) as proc:
            code = proc.wait()

        if options.inverse == (code != 0):
            sys.exit(code)

        LOG.debug("Failed with %d, retry in %f seconds", code, sleep_time)
        time.sleep(sleep_time)
        sleep_time = min(cap, random.uniform(base, sleep_time * 3))  # noqa: S311


if __name__ == "__main__":
    main()
