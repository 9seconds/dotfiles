from __future__ import annotations

import argparse
import logging
import os
import signal
import subprocess
import sys
import typing as t

from nineseconds import cli
from nineseconds import cmd
from nineseconds import env


LOG: t.Final = logging.getLogger(__name__)


@cli.main
def main() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="9seconds timeouts commands.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.set_defaults(cmd=run)

    parser.add_argument(
        "-t",
        "--timeout",
        type=cli.type_duration,
        **cli.env_argument(
            "max execution time", f"{env.PREFIX}_TIMEOUT", lambda: "1h"
        ),
    )
    parser.add_argument(
        "-s",
        "--signal",
        type=cli.type_signal,
        **cli.env_argument(
            "timeout signal",
            f"{env.PREFIX}_SIGNAL",
            lambda: "SIGTERM",
        ),
    )
    parser.add_argument(
        "-k",
        "--kill-after",
        type=cli.type_duration,
        **cli.env_argument(
            "send SIGKILL after",
            f"{env.PREFIX}_KILL_AFTER",
            lambda: "5s",
        ),
    )

    parser.add_argument(
        "command", nargs=argparse.ONE_OR_MORE, help="command to execute"
    )

    return parser


def run(options: argparse.Namespace) -> None:
    with cmd.run_in_foreground(*options.command) as proc:
        try:
            exit_code = proc.wait(options.timeout.total_seconds())
        except subprocess.TimeoutExpired:
            LOG.debug("Timeout expired, start graceful period")
        else:
            sysexit(exit_code)

        os.kill(proc.pid, options.signal)

        try:
            exit_code = proc.wait(options.kill_after.total_seconds())
        except subprocess.TimeoutExpired:
            LOG.debug("Graceful period expired")
        else:
            sysexit(exit_code)

        os.kill(proc.pid, signal.SIGKILL)
        sysexit(proc.wait())


def sysexit(code: int) -> t.NoReturn:
    sys.exit(128 - code if code < 0 else code)


if __name__ == "__main__":
    main()
