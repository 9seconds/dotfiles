#!/usr/bin/env bash

script=${BASH_SOURCE[0]}
if [[ $script != */* ]]; then
    # Bash can open a script by name from the current directory.
    if [[ -f $script ]]; then
        # Preserve that local file instead of looking for another one in PATH.
        script=./$script
    else
        # No local file exists, so the name must have been found through PAToH
        script=$(command -v "$script") || exit 1
    fi
fi

script=$(realpath "$script") || exit 1
dir=$(dirname "$script")

PYTHONPATH=$dir/bin/.local/share/pythonpath${PYTHONPATH:+:$PYTHONPATH}
export PYTHONPATH

exec "$dir/bin/.local/bin/9s-module" "$@"
