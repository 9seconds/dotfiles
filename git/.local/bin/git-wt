from __future__ import annotations

import argparse
import functools
import logging
import pathlib
import shutil
import sys
import typing as t

from nineseconds import cli
from nineseconds import cmd
from nineseconds import env
from nineseconds import git
from nineseconds import paths
from nineseconds import strings


LOG: t.Final = logging.getLogger(__name__)
CONFIG_PATH: t.Final = paths.config("git-wt")
ENV_PREFIX: t.Final = f"{env.PREFIX}_GIT_WT"
CONFIG_OPT: t.Final = "nineseconds.wt"


if not shutil.which("9s-module"):
    sys.exit("9s-module is absent")


@cli.main
def main() -> argparse.ArgumentParser:
    def get_project() -> str:
        if git.is_inside_git_worktree(cwd=pathlib.Path.cwd()):
            return git.get_common_dir().parent.name
        return ""

    def get_storage() -> str:
        if git.is_inside_git_worktree(cwd=pathlib.Path.cwd()):
            return str(git.get_common_dir().parent.parent)
        return ""

    def type_normal_repository(value: str) -> pathlib.Path:
        path = pathlib.Path(value).absolute()
        if not git.is_inside_git_worktree(cwd=path):
            raise argparse.ArgumentTypeError("Not a git repository")

        path = git.get_common_dir(cwd=path)
        if env.as_bool(git.config_get(CONFIG_OPT, cwd=path)):
            raise argparse.ArgumentTypeError("Repository is wt")

        return path

    def type_valid_worktree(value: str) -> pathlib.Path:
        path = pathlib.Path(value).absolute()
        if not git.is_inside_git_worktree(cwd=path):
            raise argparse.ArgumentTypeError("Invalid directory")
        current_common_dir = git.get_common_dir()
        if current_common_dir != (d := git.get_common_dir(cwd=path)):
            raise argparse.ArgumentTypeError(
                f"Unexpected worktree: {current_common_dir} != {d}"
            )
        return path

    def type_absent(value: str) -> pathlib.Path:
        path = pathlib.Path(value).absolute()
        if path.exists():
            raise argparse.ArgumentTypeError("Path should not exist")
        return path

    def type_new_worktree(value: str) -> pathlib.Path:
        path = pathlib.Path(value)
        if path.is_absolute():
            return path
        return git.get_common_dir().parent / path

    def get_module() -> str:
        if not git.is_inside_git_worktree(cwd=pathlib.Path.cwd()):
            return ""

        dirname = git.get_common_dir()
        return dirname.parent.name.removeprefix(".") if dirname else ""

    parser = argparse.ArgumentParser(
        description="9seconds managed worktrees",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    commands = parser.add_subparsers(title="Commands")

    convert_cmd = commands.add_parser(
        "convert",
        description="Convert repository to worktrees.",
        help="convert to worktrees"
    )
    convert_cmd.add_argument(
        "from",
        type=type_normal_repository,
        help="Repository to convert from",
    )
    convert_cmd.add_argument(
        "to",
        type=type_absent,
        help="Path to convert to"
    )
    convert_cmd.set_defaults(cmd=do_convert)

    list_cmd = commands.add_parser(
        "list",
        aliases=["l"],
        description="List worktrees.",
        help="list worktrees",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    list_cmd.set_defaults(cmd=do_list)

    add_cmd = commands.add_parser(
        "add",
        aliases=["a"],
        description="Add a worktree.",
        help="add a worktree",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    add_cmd.add_argument(
        "worktree",
        type=type_new_worktree,
        help="Worktree to add.",
    )
    add_cmd.set_defaults(cmd=do_add)

    remove_cmd = commands.add_parser(
        "remove",
        aliases=["r"],
        description="Remove worktrees.",
        help="remove worktrees",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    remove_cmd.add_argument(
        "worktree",
        type=type_valid_worktree,
        nargs=argparse.ONE_OR_MORE,
        help="Worktree to remove.",
    )
    remove_cmd.set_defaults(cmd=do_remove)

    for cmd_ in add_cmd, remove_cmd:
        cmd_.add_argument(
            "-m", "--module",
            **cli.env_argument(
                "module name",
                f"{ENV_PREFIX}_MODULE",
                get_module,
            )
        )

    return parser


def require_wt(
    func: t.Callable[[argparse.Namespace], None]
) -> t.Callable[[argparse.Namespace], None]:
    @functools.wraps(func)
    def decorator(options: argparse.Namespace) -> None:
        if not env.as_bool(git.config_get(CONFIG_OPT)):
            name = func.__name__.removeprefix("do_")
            sys.exit(f"Command {name!r} should be executed from wt repository")
        func(options)

    return decorator


def do_convert(options: argparse.Namespace) -> None:
    dest = options.to / ".git"

    options.to.mkdir(parents=True, exist_ok=False)
    shutil.copytree(getattr(options, "from"), dest)
    if (wt := dest / "worktrees").is_dir():
        shutil.rmtree(wt)

    git.config_set("core.bare", "true", cwd=dest)
    git.config_set(CONFIG_OPT, "1", cwd=dest)


@require_wt
def do_list(options: argparse.Namespace) -> None:
    worktrees = {}
    name = ""

    for line in git.run("worktree", "list", "--porcelain"):
        match line.split():
            case ["worktree", *pth]:
                name = " ".join(pth)
            case ["bare"]:
                name = ""
            case [] if name != "":
                worktrees[name] = git.get_current_branch(cwd=name)

    strings.print_rows(
        [
            (name, f"({branch})" if branch else "")
            for name, branch in sorted(worktrees.items())
        ],
        is_shlex=options.shlex
    )


@require_wt
def do_add(options: argparse.Namespace) -> None:
    git.run(
        "worktree", "add",
        "--detach",
        "--no-guess-remote",
        options.worktree
    )
    if CONFIG_PATH.joinpath(options.module).is_dir():
        module_cmd(options.worktree, "plug", options.module)


@require_wt
def do_remove(options: argparse.Namespace) -> None:
    for pth in set(options.worktree):
        if CONFIG_PATH.joinpath(options.module).is_dir():
            module_cmd(pth, "unplug", options.module)
        git.run("worktree", "remove", "--force", pth)


def module_cmd(
    target: pathlib.Path,
    action: t.Literal["plug", "unplug"],
    module: str
) -> list[str]:
    return cmd.run(
        "9s-module",
        "--source-dir", CONFIG_PATH,
        "--target-dir", target,
        action,
        "--no-cache",
        module
    )


if __name__ == "__main__":
    main()
