{
  "$schema": "https://opencode.ai/config.json",

  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "github-copilot", "effect": "allow" },
    { "action": "provider.use", "resource": "mistral", "effect": "allow" }
  ],

  "update": "disable",
  "compaction": {
    "auto": true,
    "buffer": 50000
  },

  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "bash -n *", "effect": "allow" },
    { "action": "shell", "resource": "col *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "docker image inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker image ls *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "man *", "effect": "allow" },
    { "action": "shell", "resource": "nl *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "pyrefly check *", "effect": "allow" },
    { "action": "shell", "resource": "python -m py_compile *", "effect": "allow" },
    { "action": "shell", "resource": "python -m unittest *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m py_compile *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m unittest *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "ruff check *", "effect": "allow" },
    { "action": "shell", "resource": "shift *", "effect": "allow" },
    { "action": "shell", "resource": "sleep *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl cat *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl list-*", "effect": "allow" },
    { "action": "shell", "resource": "systemctl show *", "effect": "allow" },
    { "action": "shell", "resource": "true *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "docker top *", "effect": "allow" },
    { "action": "shell", "resource": "getfacl *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" }
  ],

  "mcp": {
    "servers": {
      "cs": {
        "command": ["cs", "--find-root", "--mcp"],
        "type": "local",
        "disabled": false
      },

      "context7": {
        "command": ["context7-mcp"],
        "type": "local",
        "disabled": false
      },

      "tavily": {
        "command": ["tavily-mcp"],
        "type": "local",
        "disabled": false
      },

      "github": {
        "command": ["github-mcp-server", "stdio", "--read-only"],
        "type": "local",
        "disabled": false
      }
    }
  },

  "lsp": {
    "pyrefly": {
      "command": [
        "pyrefly",
        "lsp"
      ],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "pyrefly": {
          "typeCheckingMode": "off"
        }
      },
      "type": "local",
      "enabled": true
    },

    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"],
      "type": "local",
      "enabled": true
    },

    "pyright": {
      "disabled": true
    }
  }
}
