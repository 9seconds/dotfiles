{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 50000
  },

  "permission": {
    "read": "allow",
    "grep": "allow",
    "task": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "bash -n *": "allow",
      "col *": "allow",
      "diff *": "allow",
      "docker image inspect *": "allow",
      "docker image ls *": "allow",
      "find *": "allow",
      "git blame *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git merge-base *": "allow",
      "git merge-base *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls": "allow",
      "man *": "allow",
      "nl *": "allow",
      "pyrefly check *": "allow",
      "python -m py_compile *": "allow",
      "rg *": "allow",
      "ruff check *": "allow",
      "sort *": "allow",
      "systemctl cat *": "allow",
      "systemctl list-*": "allow",
      "systemctl show *": "allow",
      "true *": "allow",
      "true *": "allow",
      "uniq *": "allow",
      "wc *": "allow"
    }
  },

  "mcp": {
    "cs": {
      "command": ["cs", "--find-root", "--mcp"],
      "type": "local",
      "enabled": true
    },

    "context7": {
      "command": ["context7-mcp"],
      "type": "local",
      "enabled": true
    },

    "tavily": {
      "command": ["tavily-mcp"],
      "type": "local",
      "enabled": true
    },

    "github": {
      "command": ["github-mcp-server", "stdio", "--read-only"],
      "type": "local",
      "enabled": true
    }
  },

  "lsp": {
    "pyrefly": {
      "command": [
        "pyrefly",
        "lsp"
      ],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "pyrefly": {
          "typeCheckingMode": "off"
        }
      },
      "type": "local",
      "enabled": true
    },

    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"],
      "type": "local",
      "enabled": true
    },

    "pyright": {
      "disabled": true
    }
  }
}
